# Copy this file to .env (same folder) and fill in the values.
# .env is git-ignored; never commit real keys.
# docker-compose.yml loads it into the platform, scoring and explainer services,
# and the platform passes these three through to training jobs.

# Supabase project holding the ARGUS data (read-only sync; training/argus_ft/supabase_data.py)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<supabase-key>

# Optional: Hugging Face token, only needed for gated models (Llama 3.2, Gemma 2) in production
HF_TOKEN=

# Optional overrides (defaults shown in platform/app/core/config.py; any setting takes the ARGUS_ prefix)
# ARGUS_SCORING_TOKEN=demo-service-token
# ARGUS_SCORING_ADMIN_TOKEN=demo-admin-token
