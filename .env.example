# Copy this file to .env (same folder) and fill in the values.
# .env is git-ignored; never commit real keys.
# docker-compose.yml loads it into the platform, scoring, stream and explainer services,
# and the platform passes SUPABASE_URL / SUPABASE_KEY / HF_TOKEN through to training jobs.

# Supabase project holding the ARGUS data (read-only sync; training/argus_ft/supabase_data.py)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<supabase-key>

# Optional: Hugging Face token, only needed for gated models (Llama 3.2, Gemma 2) in production
HF_TOKEN=

# Optional overrides (defaults shown in platform/app/core/config.py; any platform setting takes the ARGUS_ prefix)
# Fraud Model API tokens: the scoring service and the platform both read these two. Locally the demo values in
# training/configs/base.yaml apply; on a GPU VM deploy/hyperstack/setup_vm.sh generates random ones.
# ARGUS_SCORING_TOKEN=demo-service-token
# ARGUS_SCORING_ADMIN_TOKEN=demo-admin-token

# ---- Host ports: only when one is already taken on this machine (defaults shown) ----------------------------------
# Containers still reach each other on their internal ports; argus.ps1, the VM scripts and the UI links follow these.
# ARGUS_UI_PORT=3000
# ARGUS_API_PORT=8090
# ARGUS_MLFLOW_PORT=5000
# ARGUS_SCORING_PORT=8080
# ARGUS_EXPLAINER_PORT=8000
# ARGUS_STREAM_PORT=8003

# ---- No NVIDIA GPU on this machine ---------------------------------------------------------------------------------
# argus.ps1 detects it and adds docker-compose.nogpu.yml (UI, platform and MLflow start; training / serving need a GPU).
# Plain docker compose instead:  COMPOSE_FILE=docker-compose.yml;docker-compose.nogpu.yml  and  COMPOSE_PATH_SEPARATOR=;

# ---- Everything below can also be changed on the UI's Settings page ---------------------------------------------
# The page writes this same file (comments and unknown keys are kept); "Apply" restarts what reads a changed value:
#   bash deploy/hyperstack/apply.sh <services>   (GPU VM)      .\argus.ps1 apply <services>   (Windows)

# ---- GPU VM (deploy/hyperstack; set by setup_vm.sh) -------------------------------------------------------------
# The VM profile the scripts use when no PROFILE is given (setup_vm.sh saves the first one): prod for live traffic,
# demo for demonstrations (forced branches, never behind live traffic), smoke for a health run. Unset: they ask.
# ARGUS_PROFILE=prod
# Every port binds to 127.0.0.1 by default (this machine only). ARGUS_BIND opens the UI / platform / MLflow / vLLM /
# stream (no login: keep it off on a public host); ARGUS_SCORING_BIND opens the token-protected Fraud Model API
# (setup_vm.sh sets it on the VM, where AWS calls it).
# ARGUS_BIND=0.0.0.0
# ARGUS_SCORING_BIND=0.0.0.0
# Profile whose api: section the Fraud Model API runs with (default configs/local_demo.yaml). prod_a100 is
# production mode: demo (forced / unmeasured) runs are refused. Changing it in production needs two-person approval.
# SCORING_CONFIG=configs/prod_a100.yaml

# ---- Real-time stream (Live stream page) -------------------------------------------------------------------------
# Local: `.\argus.ps1 stream` (Kinesis emulator). On AWS: `python deploy/ops.py platform-env` prints both lines.
# ARGUS_STREAM_URL=http://stream:8003
# ARGUS_STREAM_CONTROL_KEY=local-control-key
# Traffic source for the stream producer: synthetic | holdout | mix
# PRODUCER_SOURCE=mix

# ---- AWS from the UI (AWS deployment page) -------------------------------------------------------------------------
# Deploy / destroy run the repository's GitHub workflows: a fine-grained token for this repository with Actions,
# Variables and Secrets read/write. No AWS key is ever stored here. Repository default: the git remote origin.
# ARGUS_GITHUB_REPO=owner/repo
# ARGUS_GITHUB_TOKEN=github_pat_...

# ---- AWS deployment (python deploy/ops.py up; see deploy/README.md) ---------------------------------------------
# Both values come from the GPU VM: training/outputs/_deploy/aws.env (written by deploy/hyperstack/pipeline.sh)
# TF_VAR_scoring_host=<gpu-vm-public-ip>
# TF_VAR_scoring_token=<ARGUS_SCORING_TOKEN of the VM>
# AWS_REGION=ap-south-1
# TF_VAR_alert_email=you@example.com
# Who may reach the stream API (default: the GPU VM + this machine's public IP):
# TF_VAR_allowed_cidrs=["203.0.113.7/32"]
